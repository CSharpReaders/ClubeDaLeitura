@{
    Layout = "_Layout";
    ViewBag.Titulo = "Concluir Emprestimo";

    List<ListarAmigoNomeViewModel> amigos = ViewBag.Amigos;
    List<ListarRevistaNomeViewModels> revistas = ViewBag.Revistas;
}

@model ConcluirEmprestimoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Concluir"
      method="post">

    <div class="mb-3">
        <label asp-for="Id" class="form-label fw-semibold text-primary text-uppercase small">ID</label>
        <select asp-for="Id" class="form-control">
            <option value="@Model.Id" selected>@Model.Id</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="NomeAmigo" class="form-label fw-semibold text-primary text-uppercase small">Amigo</label>
        <select asp-for="NomeAmigo" class="form-control">
            <option value="@Model.NomeAmigo" selected>@Model.NomeAmigo</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="NomeRevista" class="form-label fw-semibold text-primary text-uppercase small">Revista</label>
        <select asp-for="NomeRevista" class="form-control">
            <option value="@Model.NomeRevista" selected>@Model.NomeRevista</option>
        </select>
    </div>

    <div class="alert alert-warning fw-bold" role="alert">
        Deseja Concluir o Emprestimo: @Model.Id?
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
